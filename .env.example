# InvestIQ environment variables.
#
# Local dev: copy to `.env` (browser VITE_* values and server values) and, for `wrangler dev`
# against a production build, to `.dev.vars` (server values only). Never commit real values.
# Production: browser VITE_* values are baked in at build time (GitHub Actions variables);
# server values are Cloudflare Worker secrets (`wrangler secret put NAME`). See README.md.

# ---------------------------------------------------------------------------
# Supabase  (public project URL + publishable/anon key: safe in the browser bundle)
# Find both in Supabase dashboard > Project Settings > API.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-side equivalents (optional; fall back to the VITE_* values above)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SECRET. Service-role key; bypasses RLS. Server only, never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Public base URL of the deployed backend (links, webhooks, internal cron calls)
# Defaults to https://investiq-me.rakeshpavuluri999.workers.dev when empty.
# ---------------------------------------------------------------------------
PROD_URL=
VITE_PROD_URL=

# ---------------------------------------------------------------------------
# Admin console (/desktop/admin). SECRETS.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random string (>= 32 chars) used to sign the admin session cookie, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Public API keys for external consumers (comma-separated lists allowed). SECRETS.
# ---------------------------------------------------------------------------
NSE_FNO_API_KEY=
GLOBAL_API_KEY=
# Key checked by /api/public/option-chain
OPTION_CHAIN_API_KEY=

# ---------------------------------------------------------------------------
# HTTP hardening
# ---------------------------------------------------------------------------
# Comma-separated browser origins allowed for CORS (e.g. https://investiq-me.rakeshpavuluri999.workers.dev)
ALLOWED_ORIGINS=
# Comma-separated hostnames the trade dispatcher may POST to (SSRF allow-list)
DISPATCH_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Cron + webhook authentication. SECRETS. Generate with `openssl rand -hex 32`.
# ---------------------------------------------------------------------------
# Sent as `x-cron-secret` by Cloudflare Cron Triggers and by any external scheduler
CRON_SECRET=
# Must equal the secret_token passed to Telegram setWebhook
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Telegram alerts. SECRETS (the bot token is a credential).
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids that receive alerts
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# AI (Google Gemini). SECRET.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional alternative AI gateway key (used when GEMINI_API_KEY is empty)
LOVABLE_API_KEY=

# ---------------------------------------------------------------------------
# Market data providers. SECRETS.
# ---------------------------------------------------------------------------
# DhanHQ API v2
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Upstox (option chain)
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Groww
GROWW_API_KEY=
GROWW_API_SECRET=
# Sensibull: only an authorised partner agreement is supported. Session cookies and access
# tokens are not read anywhere. Leave empty if you have no partner agreement.
SENSIBULL_PARTNER_API_KEY=
SENSIBULL_PARTNER_SECRET=
SENSIBULL_PARTNER_API_BASE_URL=
SENSIBULL_PARTNER_GREEKS_PATH=

# ---------------------------------------------------------------------------
# Google Sheet feeding the RSI alert (optional)
# ---------------------------------------------------------------------------
RSI_SHEET_URL=
RSI_SHEET_NAME=

# ---------------------------------------------------------------------------
# Safety switch. Synthetic/mock market data is served ONLY when this is exactly "true".
# Leave unset in production.
# ---------------------------------------------------------------------------
ALLOW_MOCK_DATA=

# ---------------------------------------------------------------------------
# Optional behaviour switches
# ---------------------------------------------------------------------------
# "true" enables the delayed CBOE public feed for US index options. Confirm its terms first.
ENABLE_GLOBAL_OPTIONS_FEED=
# "true" lets any visitor connect a Dhan account from the browser in production, swapping the
# shared broker credentials. Leave unset and use the DHAN_* secrets instead.
ALLOW_RUNTIME_DHAN_CONNECT=
