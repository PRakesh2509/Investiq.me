// Cloudflare Workers config for InvestIQ (production: investiq-me.rakeshpavuluri999.workers.dev).
//
// `main` and `assets` are intentionally NOT set here: `vite build` runs Nitro (cloudflare-module
// preset), which merges this file with the real build output into .output/server/wrangler.json
// (main = index.mjs, assets = ../public) and writes .wrangler/deploy/config.json so that
// `wrangler deploy` / `wrangler dev` run from the repo root pick that generated config up.
// Always `npm run build` before deploying.
//
// Secrets are never stored here. Set them with `wrangler secret put <NAME>` (see README.md).
// `vars` is deliberately empty; PROD_URL is optional (defaults to the workers.dev URL).
{
  "name": "investiq-me",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Cron Triggers run in UTC. Keep in sync with src/lib/cron-schedule.ts (unit-tested).
  // IST = UTC+5:30:
  //   30 3  * * 1-5     09:00 IST  pre-market top gainers (Mon-Fri)
  //   0 4   * * 1       09:30 IST  mutual fund weekly digest (Monday only)
  //   0 4   * * 1-5     09:30 IST  IPO alerts morning check (Mon-Fri)
  //   15 6  * * 1-5     11:45 IST  daily RSI alerts (Mon-Fri)
  //   0 8   * * 1-5     13:30 IST  IPO alerts afternoon check (Mon-Fri)
  //   45 10 * * 1-5     16:15 IST  post-market summary (Mon-Fri)
  //   0 11  * * 1-5     16:30 IST  post-market sectors (Mon-Fri)
  //   15 11 * * 1-5     16:45 IST  post-market trending (Mon-Fri)
  //   */10 3-10 * * 1-5 08:30-16:20 IST stock & ETF news (market hours 09:15-15:30)
  //   */15 3-10 * * 1-5 09:15-15:30 IST F&O sniper trade alerts (DhanHQ live feed)
  "triggers": {
    "crons": [
      "30 3 * * 1-5",
      "0 4 * * 1",
      "0 4 * * 1-5",
      "15 6 * * 1-5",
      "0 8 * * 1-5",
      "45 10 * * 1-5",
      "0 11 * * 1-5",
      "15 11 * * 1-5",
      "*/10 3-10 * * 1-5",
      "*/15 3-10 * * 1-5"
    ]
  }
}
